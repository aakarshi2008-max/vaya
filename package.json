{
  "name": "julie-rag",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "api": "node server/index.mjs",
    "api:dev": "node --watch server/index.mjs",
    "python:vector": "python -m uvicorn backend.embed_service:app --host 127.0.0.1 --port 8081",
    "dev": "vite",
    "dev:all": "concurrently --names PY,API,UI --prefix-colors cyan,yellow,magenta \"npm run python:vector\" \"npm run api:dev\" \"npm run dev\"",
    "start": "concurrently --names PY,API,UI \"npm run python:vector\" \"npm run api\" \"npm run dev\"",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "docker:up": "docker compose up -d",
    "docker:ingest": "docker compose run --rm ingest",
    "docker:logs": "docker compose logs -f api"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.1",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@types/three": "^0.185.4",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "framer-motion": "^13.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^0.468.0",
    "page-flip": "^2.0.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.6.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.4",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5",
    "vite": "^6.0.11"
  }
}
