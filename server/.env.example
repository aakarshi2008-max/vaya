SARVAM_API_KEY=

QDRANT_URL=http://localhost:6333
EMBEDDING_URL=http://localhost:8081
QDRANT_COLLECTION=msmarco_xi_passages
API_PORT=8787

CORS_ORIGIN=http://localhost:5173,http://localhost:4173,http://localhost:3000

# LLM for answer generation (optional but recommended - Groq is free and fast)
# Get a free key at: https://console.groq.com
GROQ_API_KEY=

# Fallback if Groq not set
OPENAI_API_KEY=

# Groq model to use (llama-3.1-8b-instant is free and fast)
LLM_MODEL=llama-3.1-8b-instant

# How much context to send to the LLM (chars)
MAX_CONTEXT_CHARS=2000

LOG_LEVEL=info
